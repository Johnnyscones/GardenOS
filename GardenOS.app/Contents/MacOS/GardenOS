#!/bin/bash
BUNDLE_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"

osascript << APPLESCRIPT
tell application "Terminal"
    activate
    do script "cd \"$BUNDLE_DIR\" && bash -c '

PYTHON=\"\"
for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if command -v \$candidate &>/dev/null; then PYTHON=\"\$candidate\"; break; fi
done
for p in /usr/local/bin/python3 /opt/homebrew/bin/python3 /usr/bin/python3; do
    if [ -f \"\$p\" ] && [ -z \"\$PYTHON\" ]; then PYTHON=\"\$p\"; break; fi
done

if [ -z \"\$PYTHON\" ]; then
    echo \"ERROR: Python 3 not found.\"
    echo \"Install from https://www.python.org/downloads/ or: brew install python3\"
    read -p \"Press Enter to close...\"
    exit 1
fi

echo \"Python: \$(\$PYTHON --version)\"

if ! \$PYTHON -c \"import PyQt6\" 2>/dev/null; then
    echo \"Installing PyQt6 (one-time, takes ~30 seconds)...\"
    \$PYTHON -m pip install PyQt6 --quiet
fi

echo \"Launching GardenOS...\"
\$PYTHON garden_app.py

if [ \$? -ne 0 ]; then
    echo \"\"
    echo \"GardenOS exited with an error.\"
    read -p \"Press Enter to close...\"
fi
'"
end tell
APPLESCRIPT
